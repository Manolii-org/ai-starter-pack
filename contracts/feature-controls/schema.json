{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.example.invalid/feature-controls/v1",
  "$defs": {
    "scope": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "application": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "environment": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        }
      },
      "required": [
        "namespace",
        "application",
        "environment"
      ],
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "properties": {
        "value_type": {
          "enum": [
            "boolean",
            "number",
            "string",
            "json"
          ]
        },
        "baseline": {},
        "failure": {
          "enum": [
            "baseline",
            "deny"
          ]
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "ancestors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "experiment": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
            },
            "epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "key",
            "epoch"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "value_type",
        "baseline",
        "failure",
        "surfaces",
        "ancestors"
      ],
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "features": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1000,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
          },
          "additionalProperties": {
            "$ref": "#/$defs/feature"
          }
        }
      },
      "required": [
        "schema_version",
        "scope",
        "revision",
        "features"
      ],
      "additionalProperties": false
    },
    "bundle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "catalog_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provider_semantics": {
          "const": "growthbook:js-1.8.0:py-3.2.0:hash-2"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "payload_bytes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "approval_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        }
      },
      "required": [
        "schema_version",
        "scope",
        "revision",
        "catalog_revision",
        "created_at",
        "expires_at",
        "provider_semantics",
        "payload_sha256",
        "payload_bytes",
        "approval_ref"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "assignment_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "authorized": {
          "type": "boolean"
        },
        "eligible": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
          },
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "assignment_key",
        "authorized",
        "eligible",
        "expires_at",
        "excluded"
      ],
      "additionalProperties": false
    },
    "kill": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disabled": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
          },
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "scope",
        "generation",
        "expires_at",
        "disabled"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "exposure",
            "outcome"
          ]
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "feature_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "assignment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "configuration_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allocation_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "variant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidence": {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "render",
                "behavior",
                "business-transition"
              ]
            },
            "unit_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "source",
            "unit_key"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "scope",
        "event_id",
        "kind",
        "decision_id",
        "feature_key",
        "assignment_id",
        "configuration_revision",
        "allocation_epoch",
        "variant",
        "timestamp",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
