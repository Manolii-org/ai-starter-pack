{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "subject"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "environment",
        "kind",
        "control_sha",
        "capability_sha",
        "profile_version",
        "policy_sha256",
        "preparation",
        "timing",
        "recovery",
        "continuation",
        "entity",
        "config_sha256",
        "decision_sequence",
        "components",
        "databases",
        "qualifications",
        "unchanged_components"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "kind": {
          "enum": [
            "release",
            "activation-only"
          ]
        },
        "control_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "capability_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "run_attempt",
            "job"
          ],
          "properties": {
            "run_id": {
              "type": "integer",
              "minimum": 1
            },
            "run_attempt": {
              "type": "integer",
              "minimum": 1
            },
            "job": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_at",
            "approval_deadline",
            "execute_before",
            "intermediate_seconds"
          ],
          "properties": {
            "selected_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "approval_deadline": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "execute_before": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "intermediate_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "data_authority",
            "allowed_actions",
            "automatic_data_loss_threshold"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "data_authority": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "allowed_actions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "hold",
                  "code-rollback",
                  "forward-fix"
                ]
              }
            },
            "automatic_data_loss_threshold": {
              "const": 0
            }
          }
        },
        "continuation": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parent_release_id",
                "schema_evidence_sha256"
              ],
              "properties": {
                "parent_release_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "schema_evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "entity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_sequence": {
          "const": [
            "release"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "provider",
              "artifact_id",
              "artifact_sha256",
              "config_sha256",
              "before_artifact_id",
              "recovery_artifact_id",
              "databases",
              "id",
              "source",
              "promotion_sha",
              "features_sha256",
              "depends_on",
              "before_config_sha256",
              "before_features_sha256",
              "recovery_artifact_sha256",
              "feature_states"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "before_artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "recovery_artifact_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "databases": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repo",
                  "sha",
                  "tree"
                ],
                "properties": {
                  "repo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                  },
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "tree": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              },
              "promotion_sha": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "features_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "depends_on": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "before_config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "before_features_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "recovery_artifact_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "feature_states": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "readiness",
                    "default_enabled",
                    "intentional_off",
                    "killed",
                    "control_generation"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                    },
                    "readiness": {
                      "enum": [
                        "development",
                        "ready"
                      ]
                    },
                    "default_enabled": {
                      "type": "boolean"
                    },
                    "intentional_off": {
                      "type": "boolean"
                    },
                    "killed": {
                      "type": "boolean"
                    },
                    "control_generation": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "databases": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "adapter",
              "baseline",
              "pending",
              "expected_after",
              "migration_sha256",
              "backup_required",
              "source",
              "writer",
              "fixture_version",
              "compatible_components"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "adapter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "baseline": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "pending": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "expected_after": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "migration_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "backup_required": {
                "type": "boolean"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repo",
                  "sha",
                  "tree"
                ],
                "properties": {
                  "repo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                  },
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "tree": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              },
              "writer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "fixture_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "compatible_components": {
                "type": "array",
                "uniqueItems": true,
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            }
          }
        },
        "qualifications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "workflow",
              "provider",
              "run_id",
              "run_attempt",
              "evidence_sha256",
              "tested_subject_sha256",
              "completed_at",
              "retain_until",
              "first_attempt",
              "retry_count",
              "status",
              "obligations"
            ],
            "properties": {
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "workflow": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "run_id": {
                "type": "integer",
                "minimum": 1
              },
              "run_attempt": {
                "type": "integer",
                "minimum": 1
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "tested_subject_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "completed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "retain_until": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "first_attempt": {
                "enum": [
                  "success",
                  "failure"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "const": "success"
              },
              "obligations": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        "unchanged_components": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "artifact_id",
              "config_sha256",
              "features_sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repo",
                  "sha",
                  "tree"
                ],
                "properties": {
                  "repo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                  },
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "tree": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              },
              "artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "features_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "activation-only"
              }
            }
          },
          "then": {
            "properties": {
              "continuation": {
                "type": "object"
              },
              "decision_sequence": {
                "const": [
                  "release"
                ]
              },
              "databases": {
                "items": {
                  "properties": {
                    "pending": {
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "continuation": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-starter-pack:release-manifest:v2",
  "title": "Entity-local selected release record v2",
  "description": "Immutable component vector; validation grants no approval or execution authority."
}
