{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://schemas.manolii.com/email-capture/v1/profile.schema.json",
  "title": "profile",
  "required": [
    "schema_version",
    "mode",
    "backend",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "pattern": "^1\\.",
      "type": "string"
    },
    "mode": {
      "enum": [
        "off",
        "hermetic",
        "hosted"
      ]
    },
    "backend": {
      "enum": [
        "memory",
        "mailpit",
        "maildev",
        "inbucket",
        "hosted"
      ]
    },
    "endpoint": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "fidelity": {
      "enum": [
        "provider-to-capture",
        "deployed-substitution"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "backend": {
            "enum": [
              "mailpit",
              "maildev",
              "inbucket"
            ]
          }
        },
        "required": [
          "backend"
        ]
      },
      "then": {
        "required": [
          "endpoint"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "hosted"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "backend",
          "endpoint",
          "environment"
        ],
        "properties": {
          "backend": {
            "const": "hosted"
          },
          "environment": {
            "type": "string",
            "enum": [
              "test",
              "ci",
              "preview",
              "preprod",
              "staging"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "environment": {
                  "const": "test"
                }
              },
              "required": [
                "environment"
              ]
            },
            "then": {
              "properties": {
                "endpoint": {
                  "type": "string",
                  "minLength": 8,
                  "pattern": "^(https://[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+(?::[0-9]+)?(?:/[^\\s?#@]*)?|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?(/[^\\s?#@]*)?)$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "environment": {
                  "enum": [
                    "ci",
                    "preview",
                    "preprod",
                    "staging"
                  ]
                }
              },
              "required": [
                "environment"
              ]
            },
            "then": {
              "properties": {
                "endpoint": {
                  "type": "string",
                  "minLength": 8,
                  "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+(?::[0-9]+)?(?:/[^\\s?#@]*)?$"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "hermetic"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "backend": {
            "enum": [
              "memory",
              "mailpit",
              "maildev",
              "inbucket"
            ]
          }
        }
      }
    }
  ]
}
