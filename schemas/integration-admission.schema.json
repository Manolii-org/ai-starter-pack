{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manolii.dev/schemas/integration-admission.schema.json",
  "title": "Integration Admission configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "required_context", "surfaces"],
  "properties": {
    "schema_version": {"const": 1},
    "required_context": {"type": "string", "minLength": 1},
    "unknown_paths": {"enum": ["block", "all"], "default": "block"},
    "global_invalidators": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "commands"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "default": []
          },
          "invalidates": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "default": []
          },
          "inputs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "default": []
          },
          "lane": {"type": "string", "minLength": 1, "default": "default"},
          "working_directory": {"type": "string", "minLength": 1, "default": "."}
        }
      }
    }
  }
}
