{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "operation",
    "outcome",
    "duration_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "provider": {
      "const": "unspam"
    },
    "operation": {
      "enum": [
        "status",
        "start",
        "wait",
        "run"
      ]
    },
    "outcome": {
      "enum": [
        "ready",
        "started",
        "passed",
        "assertion_failed",
        "blocked"
      ]
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "account_mode": {
      "enum": [
        "shared",
        "dedicated"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org",
        "repository",
        "environment"
      ],
      "properties": {
        "org": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      }
    },
    "error_code": {
      "type": "string",
      "pattern": "^[A-Z_]+$"
    },
    "remaining": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spam_checks",
        "inbox_placements"
      ],
      "properties": {
        "spam_checks": {
          "type": "integer",
          "minimum": 0
        },
        "inbox_placements": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "passed"
        ],
        "properties": {
          "kind": {
            "enum": [
              "spam",
              "inbox"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "inbox_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mailbox_count": {
            "type": "integer",
            "minimum": 1
          },
          "explicit_inbox_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "placement_counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inbox": {
                "type": "integer",
                "minimum": 0
              },
              "updates": {
                "type": "integer",
                "minimum": 0
              },
              "newsletter": {
                "type": "integer",
                "minimum": 0
              },
              "promotions": {
                "type": "integer",
                "minimum": 0
              },
              "social": {
                "type": "integer",
                "minimum": 0
              },
              "forums": {
                "type": "integer",
                "minimum": 0
              },
              "spam": {
                "type": "integer",
                "minimum": 0
              },
              "missing": {
                "type": "integer",
                "minimum": 0
              },
              "unknown": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "inbox",
              "updates",
              "newsletter",
              "promotions",
              "social",
              "forums",
              "spam",
              "missing",
              "unknown"
            ]
          },
          "placements": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "placement"
              ],
              "properties": {
                "mailbox_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "placement": {
                  "enum": [
                    "inbox",
                    "updates",
                    "newsletter",
                    "promotions",
                    "social",
                    "forums",
                    "spam",
                    "missing",
                    "unknown"
                  ]
                }
              }
            }
          },
          "non_spam_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
