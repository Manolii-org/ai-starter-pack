{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-starter-pack:release-manifest:v1",
  "title": "Release manifest v1",
  "description": "Immutable release subject metadata. Validation proves shape and internal consistency, never approval or live state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "subject"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "environment",
        "kind",
        "source_sha",
        "control_sha",
        "capability_sha",
        "profile_version",
        "policy_sha256",
        "decision_sequence",
        "preparation",
        "artifacts",
        "databases",
        "qualification",
        "timing",
        "recovery",
        "continuation"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "kind": {
          "enum": [
            "release",
            "activation-only"
          ]
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "control_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "capability_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_sequence": {
          "enum": [
            [],
            [
              "activation"
            ],
            [
              "schema",
              "activation"
            ],
            [
              "release"
            ]
          ]
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "run_attempt",
            "job"
          ],
          "properties": {
            "run_id": {
              "type": "integer",
              "minimum": 1
            },
            "run_attempt": {
              "type": "integer",
              "minimum": 1
            },
            "job": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "provider",
              "artifact_id",
              "artifact_sha256",
              "config_sha256",
              "before_artifact_id",
              "recovery_artifact_id",
              "databases"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "before_artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "recovery_artifact_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "databases": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            }
          }
        },
        "databases": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "adapter",
              "baseline",
              "pending",
              "expected_after",
              "migration_sha256",
              "backup_required"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "adapter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "baseline": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "pending": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "expected_after": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "migration_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "backup_required": {
                "type": "boolean"
              }
            }
          }
        },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_sha",
            "run_id",
            "run_attempt",
            "artifact_id",
            "artifact_sha256",
            "schema_source_sha",
            "migration_sha256",
            "fixture_version"
          ],
          "properties": {
            "source_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "run_id": {
              "type": "integer",
              "minimum": 1
            },
            "run_attempt": {
              "type": "integer",
              "minimum": 1
            },
            "artifact_id": {
              "type": "integer",
              "minimum": 1
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schema_source_sha": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "migration_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fixture_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_at",
            "approval_deadline",
            "execute_before",
            "intermediate_seconds"
          ],
          "properties": {
            "selected_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "approval_deadline": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "execute_before": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "intermediate_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "data_authority",
            "allowed_actions",
            "automatic_data_loss_threshold"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "data_authority": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "allowed_actions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "hold",
                  "code-rollback",
                  "forward-fix"
                ]
              }
            },
            "automatic_data_loss_threshold": {
              "const": 0
            }
          }
        },
        "continuation": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parent_release_id",
                "schema_evidence_sha256"
              ],
              "properties": {
                "parent_release_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "schema_evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
