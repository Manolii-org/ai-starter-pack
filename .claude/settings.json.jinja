{
{% if isolation_profile != 'strict' %}
  "skipDangerousModePermissionPrompt": true,
  "model": "claude-sonnet-4-6",
  "env": {
{% if langfuse_telemetry %}
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
{% endif %}
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "MAIN_THREAD_EXECUTOR_MODEL": "claude-sonnet-4-6",
    "ADVISOR_BETA_ENABLED": "false",
    "ENABLE_TOOL_SEARCH": "auto:5"{{ ',' if langfuse_telemetry else '' }}
{% if langfuse_telemetry %}
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "{{ otel_endpoint }}",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf"
{% endif %}
  },
{% if langfuse_telemetry %}
  "otelHeadersHelper": "scripts/otel-langfuse-headers.sh",
{% endif %}
{% endif %}
  "permissions": {
{% if isolation_profile != 'strict' %}
    "defaultMode": "bypassPermissions",
{% endif %}
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(* | sh*)",
      "Bash(* | bash*)",
      "Bash(* | */sh*)",
      "Bash(* | */bash*)",
      "Bash(* | sudo *)",
      "Bash(*>*.netrc*)",
      "Bash(*tee *.netrc*)",
      "mcp__*__kl_approve_action",
      "mcp__*__kl_undo_action",
      "mcp__*__kl_approve_email_action"
    ]{{ '' if isolation_profile == 'strict' else ',' }}
{% if isolation_profile != 'strict' %}
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "NotebookEdit(*)",
      "TodoWrite(*)",
      "Agent(*)",
      "Skill(*)",
      "AskUserQuestion(*)",
      "ToolSearch(*)",
      "ExitPlanMode(*)",
      "Monitor(*)",
      "mcp__github__*",
      "mcp__playwright__*",
      "mcp__supabase__*",
      "mcp__doppler__*",
      "mcp__browserbase__*",
      "mcp__neon__*",
      "mcp__*"
    ]
{% endif %}
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_R=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\"); cd \"$_R\" && python3 scripts/pre-tool-use.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "_G=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\")}/scripts/qa/finalise-gate.sh\"; [ -f \"$_G\" ] || exit 0; sh \"$_G\" claude",
            "timeout": 1200
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_R=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\"); cd \"$_R\" && { python3 scripts/guard_check.py --clear-session-unfreezes || true; bash .claude/hooks/session-start.sh; }",
            "timeout": 30
          }
        ]
      }
    ]{% if claude_hooks %},
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_R=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\"); cd \"$_R\" && python3 scripts/instruction-load-audit.py",
            "timeout": 5
          }
        ]
      }
    ]{% endif %},
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_R=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\"); cd \"$_R\" && python3 scripts/classify-message.py",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "_R=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\"); cd \"$_R\" && python3 .claude/hooks/user-prompt.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_R=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\"); cd \"$_R\" && python3 .claude/hooks/post-tool.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_R=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\"); cd \"$_R\" && bash .claude/hooks/pre-compact.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_R=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\"); cd \"$_R\" && bash .claude/hooks/post-compact.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_R=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\"); cd \"$_R\" && bash scripts/session-stop-checklist.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "_R=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$PWD\"); cd \"$_R\" && python3 scripts/system-self-check.py > /dev/null 2>&1 && python3 scripts/build-skill-graph.py > /dev/null 2>&1; _rc=$?; mkdir -p .ai/memory; echo \"{\\\"timestamp\\\":\\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\",\\\"exit_code\\\":$_rc,\\\"event\\\":\\\"stop-hook-self-check\\\"}\" >> .ai/memory/eval-failures.jsonl",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
