{
  "schema_version": 1,
  "base": "origin/main",
  "review_paths": [
    ".github/workflows/*",
    "scripts/agent-check.py",
    "config/agent-checks.json",
    "scripts/sync-agent-validation.py",
    "scripts/install-agent-validation.py",
    "packages/feature-controls/**",
    "contracts/feature-controls/**",
    ".github/actions/feature-release-policy/**",
    "scripts/feature-release-check.py"
  ],
  "environments": [
    {
      "id": "python-types",
      "inputs": [
        "config/agent-checks.json"
      ],
      "ready_paths": [
        ".ai/agent-checks/type-venv/pyvenv.cfg",
        ".ai/agent-checks/type-venv"
      ],
      "tools": [
        "uv"
      ],
      "commands": [
        [
          "uv",
          "venv",
          "--clear",
          "--python",
          "3.14",
          ".ai/agent-checks/type-venv"
        ],
        [
          "uv",
          "pip",
          "install",
          "--python",
          ".ai/agent-checks/type-venv/bin/python",
          "mypy==1.20.0"
        ]
      ],
      "timeout_seconds": 600
    },
    {
      "id": "release-contract-python",
      "inputs": [
        "config/agent-checks.json"
      ],
      "ready_paths": [
        ".ai/agent-checks/release-venv/pyvenv.cfg",
        ".ai/agent-checks/release-venv"
      ],
      "tools": [
        "uv"
      ],
      "commands": [
        [
          "uv",
          "venv",
          "--clear",
          "--python",
          "3.12",
          ".ai/agent-checks/release-venv"
        ],
        [
          "uv",
          "pip",
          "install",
          "--python",
          ".ai/agent-checks/release-venv/bin/python",
          "jsonschema==4.25.1",
          "pyyaml==6.0.3",
          "pytest==9.2.0",
          "copier==9.19.1",
          "pip==26.2.1"
        ]
      ],
      "timeout_seconds": 600
    },
    {
      "id": "feature-controls-python",
      "inputs": [
        "package.json",
        "package-lock.json",
        "packages/feature-controls/python/pyproject.toml",
        "config/agent-checks.json"
      ],
      "ready_paths": [
        "node_modules/.package-lock.json",
        ".ai/agent-checks/feature-controls-venv/pyvenv.cfg",
        ".ai/agent-checks/feature-controls-venv",
        "node_modules"
      ],
      "tools": [
        "npm",
        "uv"
      ],
      "commands": [
        [
          "npm",
          "ci"
        ],
        [
          "uv",
          "venv",
          "--clear",
          "--python",
          "3.12",
          ".ai/agent-checks/feature-controls-venv"
        ],
        [
          "uv",
          "pip",
          "install",
          "--python",
          ".ai/agent-checks/feature-controls-venv/bin/python",
          "-e",
          "packages/feature-controls/python",
          "pytest==8.3.5",
          "ruff==0.15.8"
        ]
      ],
      "timeout_seconds": 600
    }
  ],
  "checks": [
    {
      "id": "agent-validation-contract",
      "paths": [
        "scripts/agent-check.py",
        "scripts/sync-agent-validation.py",
        "scripts/tests/test_agent_check.py",
        "docs/agent-validation.md",
        "AGENTS.md",
        "CLAUDE.md",
        ".cursor/rules/agent-validation.mdc",
        "scripts/install-agent-validation.py",
        "config/agent-checks.json",
        ".claude/skills/agent-validation/SKILL.md"
      ],
      "tools": [
        "python"
      ],
      "commands": [
        [
          "python3",
          "scripts/sync-agent-validation.py",
          "--check"
        ],
        [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "scripts/tests",
          "-p",
          "test_agent_check.py",
          "-v"
        ]
      ]
    },
    {
      "id": "shared-python-types",
      "paths": [
        "scripts/agent-check.py",
        "scripts/install-agent-validation.py",
        "config/agent-checks.json"
      ],
      "environment": "python-types",
      "tools": [
        "uv"
      ],
      "commands": [
        [
          ".ai/agent-checks/type-venv/bin/python",
          "-m",
          "mypy",
          "--ignore-missing-imports",
          "scripts/agent-check.py",
          "scripts/install-agent-validation.py"
        ]
      ]
    },
    {
      "id": "release-manifest-contract",
      "paths": [
        ".github/actions/validate-release-manifest/**",
        ".github/workflows/plugin-eval-gate.yml",
        "copier.yml",
        "config/agent-checks.json.jinja",
        "schemas/release-manifest.v1.schema.json",
        "scripts/tests/test_release_manifest.py",
        "docs/coordinated-releases.md",
        ".github/workflows/REUSABLE-WORKFLOWS.md",
        "schemas/release-adoption.v1.schema.json",
        "scripts/tests/test_release_admission_git.py",
        "plugin/manolii-framework/schemas/release-adoption.v1.schema.json",
        "plugin/manolii-framework/schemas/release-manifest.v1.schema.json",
        "registry/platform/framework/schemas/release-adoption.v1.schema.json",
        "registry/platform/framework/schemas/release-manifest.v1.schema.json",
        "scripts/tests/fixtures/release-manifest.v1.json",
        "config/agent-checks.json",
        "schemas/deployment-contract.schema.json",
        "README-STARTER-PACK.md.jinja",
        "tests/test_copier_render.py",
        "schemas/release-manifest.v2.schema.json",
        "scripts/tests/test_release_vector.py",
        "scripts/tests/fixtures/release-manifest.v2.json",
        "plugin/manolii-framework/schemas/release-manifest.v2.schema.json",
        "registry/platform/framework/schemas/release-manifest.v2.schema.json"
      ],
      "tools": [
        "uv"
      ],
      "commands": [
        [
          ".ai/agent-checks/release-venv/bin/python",
          "-m",
          "unittest",
          "discover",
          "-s",
          "scripts/tests",
          "-p",
          "test_release_*.py",
          "-q"
        ],
        [
          ".ai/agent-checks/release-venv/bin/python",
          "scripts/registry-lint.py"
        ],
        [
          ".ai/agent-checks/release-venv/bin/python",
          "-c",
          "from pathlib import Path; import sys; names=['release-adoption.v1.schema.json','release-manifest.v1.schema.json','release-manifest.v2.schema.json']; targets=['plugin/manolii-framework/schemas','registry/platform/framework/schemas']; ok=all((Path('schemas')/n).read_bytes()==(Path(t)/n).read_bytes() for t in targets for n in names); sys.exit(0 if ok else 'generated release schemas differ; run owning plugin and registry builders')"
        ],
        [
          ".ai/agent-checks/release-venv/bin/python",
          "-m",
          "pytest",
          "-q",
          "tests/test_copier_render.py",
          "-k",
          "test_rendered_readme_counts_match_rendered_tree or test_release_capability_distribution_boundary or test_agent_validation_base_uses_owner_ref or test_subscription_guest_distribution_boundary"
        ]
      ],
      "timeout_seconds": 180,
      "environment": "release-contract-python"
    },
    {
      "id": "feature-controls",
      "paths": [
        "packages/feature-controls/**",
        "contracts/feature-controls/**",
        "tests/feature_controls/**",
        "scripts/feature-release-check.py",
        ".github/actions/feature-release-policy/**",
        ".feature-controls/**",
        "package.json",
        "package-lock.json",
        "config/agent-checks.json",
        "copier.yml",
        "tests/test_feature_controls_distribution.py"
      ],
      "environment": "feature-controls-python",
      "tools": [
        "npm",
        "node",
        "uv"
      ],
      "commands": [
        [
          "npm",
          "run",
          "typecheck"
        ],
        [
          "npm",
          "test"
        ],
        [
          "npx",
          "--no-install",
          "eslint",
          "packages/feature-controls/ts"
        ],
        [
          ".ai/agent-checks/feature-controls-venv/bin/python",
          "-m",
          "pytest",
          "-q",
          "tests/feature_controls/provider_conformance.py",
          "tests/feature_controls/release_policy_conformance.py",
          "tests/feature_controls/release_policy_tool_conformance.py"
        ],
        [
          ".ai/agent-checks/feature-controls-venv/bin/python",
          "scripts/feature-release-check.py",
          "--mode",
          "source"
        ],
        [
          ".ai/agent-checks/feature-controls-venv/bin/python",
          "-c",
          "from pathlib import Path; a=Path('contracts/feature-controls/schema.json'); b=Path('packages/feature-controls/python/feature_controls/schema.json'); assert a.read_bytes()==b.read_bytes(), 'feature-control schema mirrors differ'"
        ]
      ],
      "timeout_seconds": 240
    },
    {
      "id": "feature-controls-distribution",
      "paths": [
        "scripts/feature-controls-release.py",
        "scripts/feature-controls-upgrade.py",
        "tests/test_feature_controls_distribution.py",
        "copier.yml",
        "config/agent-checks.json",
        "package.json",
        "package-lock.json",
        "packages/feature-controls/python/pyproject.toml"
      ],
      "environment": "release-contract-python",
      "tools": [
        "npm",
        "uv"
      ],
      "commands": [
        [
          ".ai/agent-checks/release-venv/bin/python",
          "-m",
          "pytest",
          "-q",
          "tests/test_feature_controls_distribution.py"
        ]
      ],
      "timeout_seconds": 240
    },
    {
      "id": "assessment-sast-failure-contract",
      "paths": [
        ".github/workflows/pr-assessment*.yml",
        "tests/test_assessment_sast_failure.py",
        "tests/test_pr_assessment_draft_skip.py",
        "config/agent-checks.json",
        "tests/test_broad_agents_complete_input.py",
        "tests/test_hydrate_assessment.py",
        "tests/test_pr_assessment_runner_policy.py",
        "scripts/lib/sast_evidence.py",
        "scripts/safe_env.sh",
        "tests/test_sast_evidence.py",
        "tests/test_safe_env.py",
        ".github/actions/validate-database-migrations/action.yml",
        ".github/workflows/e2e-playwright-reusable.yml",
        ".github/workflows/email-capture-live-conformance.yml",
        ".github/workflows/integration-admission-reusable.yml",
        ".github/workflows/pr-autofix-loop*.yml",
        ".github/workflows/setup-env-secret.yml",
        ".github/workflows/static-review.yml",
        "tests/test_autofix_hardening.py",
        "tests/test_e2e_activation.py",
        "tests/test_integration_admission_workflow.py",
        "tests/test_shared_gates_yaml.py",
        ".github/actions/check-guarded-paths/action.yml",
        ".github/workflows/coverage-ratchet-reusable.yml",
        ".github/workflows/migration-run-gate-reusable.yml",
        ".github/workflows/tier-gate-summary-reusable.yml",
        ".github/workflows/publish-litellm-product-release.yml",
        "tests/test_tier_reusables.py",
        "tests/test_coverage_ratchet_activation.py",
        "tests/test_guard_check.py",
        "tests/test_litellm_product_asset.py"
      ],
      "tools": [
        "python"
      ],
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_assessment_sast_failure.py",
          "tests/test_pr_assessment_draft_skip.py",
          "tests/test_pr_assessment_runner_policy.py",
          "tests/test_broad_agents_complete_input.py",
          "tests/test_hydrate_assessment.py",
          "tests/test_sast_evidence.py",
          "tests/test_safe_env.py",
          "tests/test_autofix_hardening.py",
          "tests/test_e2e_activation.py",
          "tests/test_integration_admission_workflow.py",
          "tests/test_shared_gates_yaml.py",
          "tests/test_tier_reusables.py",
          "tests/test_coverage_ratchet_activation.py",
          "tests/test_guard_check.py",
          "tests/test_litellm_product_asset.py"
        ]
      ],
      "ci_sources": [
        {
          "path": ".github/workflows/plugin-eval-gate.yml",
          "contains": "python3 -m pytest tests/ -q"
        }
      ],
      "timeout_seconds": 120
    },
    {
      "id": "subscription-automation-text-contract",
      "paths": [
        "scripts/ci/codex_automation_adapter.py",
        "scripts/ci/codex_automation_context.py",
        "scripts/ci/codex_subscription_text.py",
        "scripts/ci/codex_text_response.py",
        "scripts/lib/subscription_guest.py",
        "scripts/lib/agent_capabilities.py",
        "scripts/run-pr-classifier.py",
        "scripts/run-specialists.py",
        "scripts/run-broad-agents.py",
        "scripts/run-judge.py",
        "tests/test_codex_automation_adapter.py",
        "tests/test_agent_capabilities.py",
        "tests/test_classifier_rule1_scope.py",
        "tests/test_specialists_thinking_starvation.py",
        "tests/test_broad_agents_complete_input.py",
        "tests/test_judge_source_evidence.py",
        "tests/test_codex_subscription_text.py",
        "config/agent-checks.json"
      ],
      "tools": [
        "python"
      ],
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_codex_automation_adapter.py",
          "tests/test_agent_capabilities.py",
          "tests/test_classifier_rule1_scope.py",
          "tests/test_specialists_thinking_starvation.py",
          "tests/test_broad_agents_complete_input.py",
          "tests/test_judge_source_evidence.py",
          "tests/test_codex_subscription_text.py"
        ]
      ],
      "ci_sources": [
        {
          "path": ".github/workflows/plugin-eval-gate.yml",
          "contains": "python3 -m pytest tests/ -q"
        }
      ],
      "timeout_seconds": 120
    }
  ]
}
