{
  "schema_version": 1,
  "required_context": "Integration Admission",
  "unknown_paths": "block",
  "global_invalidators": [
    "package-lock.json",
    "pnpm-lock.yaml",
    ".github/workflows/integration-admission.yml",
    "config/integration-admission.json"
  ],
  "surfaces": {
    "web": {
      "paths": ["app/**"],
      "inputs": ["app/package.json", "app/tsconfig.json"],
      "commands": ["pnpm --dir app typecheck", "pnpm --dir app test", "pnpm --dir app build"],
      "depends_on": ["schema-contract"],
      "lane": "node",
      "working_directory": "."
    },
    "schema-contract": {
      "paths": ["supabase/migrations/**", "supabase/tests/**", "app/src/lib/database.types.ts"],
      "inputs": ["supabase/migrations/**", "supabase/tests/**"],
      "commands": ["bash scripts/ci/test-schema-contract.sh"],
      "invalidates": ["web"],
      "lane": "database",
      "working_directory": "."
    }
  }
}
