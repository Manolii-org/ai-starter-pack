{% set canonical %}{% include "config/agent-checks.json" %}{% endset %}
{% set owner = canonical | from_json %}
{% set checks = owner.checks | rejectattr('id', 'in', ['release-manifest-contract', 'feature-controls', 'feature-controls-distribution', 'assessment-sast-failure-contract', 'registry-bootstrap-contract', 'native-owner-recipe-contract']) | list %}
{% set environments = owner.environments | rejectattr('id', 'in', ['release-contract-python', 'feature-controls-python']) | list %}
{# These exact Pack-maintenance commands require optional QA/projection code.
   The Linux executor tools/commands never become portable Mac dependencies.
   Preserve every portable command and the stable owner check identity. #}
{% set pack_only_paths = ['scripts/tests/test_source_scope_boundary.py', 'scripts/tests/test_source_projection.py', 'scripts/lib/source_projection.py', 'scripts/lib/source_executor.py', 'scripts/tests/test_source_executor.py', 'docs/source-only-execution.md', '.github/workflows/plugin-eval-gate.yml', 'scripts/source-adapter-probe.py', 'scripts/tests/test_source_adapter_probe.py'] %}
{% set pack_only_commands = [
  ['python3', '-m', 'unittest', 'discover', '-s', 'scripts/tests', '-p', 'test_source_scope_boundary.py', '-v'],
  ['python3', '-m', 'unittest', 'discover', '-s', 'scripts/tests', '-p', 'test_source_projection.py', '-v'],
  ['python3', '-m', 'unittest', 'discover', '-s', 'scripts/tests', '-p', 'test_source_executor.py', '-v'],
  ['python3', '-m', 'unittest', 'discover', '-s', 'scripts/tests', '-p', 'test_source_adapter_probe.py', '-v']
] %}
{% set portable = namespace(checks=[]) %}
{% for check in checks %}
  {% if check.id == 'agent-validation-contract' %}
    {% set check = dict(check, paths=check.paths | reject('in', pack_only_paths) | list, commands=check.commands | reject('in', pack_only_commands) | list, tools=check.tools | reject('in', ['bwrap', 'cc']) | list) %}
  {% endif %}
  {% set portable.checks = portable.checks + [check] %}
{% endfor %}
{{ dict(owner, base=agent_validation_base, checks=portable.checks, environments=environments) | tojson(indent=2) }}
