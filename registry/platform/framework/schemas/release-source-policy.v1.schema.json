{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted compiled owner code-source policy (non-authorizing)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo",
    "entity",
    "control_sha",
    "capability_sha",
    "profile_version",
    "allowed_code_sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "control_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "capability_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "allowed_code_sources": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "sha",
          "tree"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "minLength": 40,
            "maxLength": 40
          },
          "tree": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "minLength": 40,
            "maxLength": 40
          }
        }
      }
    }
  }
}
