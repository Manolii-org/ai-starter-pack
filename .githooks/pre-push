#!/usr/bin/env bash
# pre-push hook — finalise gate (affected agent checks, cached by input digest).
#
# Runs scripts/qa/finalise-gate.py, which executes scripts/agent-check.py only
# when config/agent-checks.json exists and blocks the push only on a real
# check failure (docs/qa-framework.md). Infrastructure gaps warn instead.
#
# INSTALL (one-time per clone):
#   git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
exec sh "$ROOT/scripts/qa/finalise-gate.sh" git-pre-push "$@"
