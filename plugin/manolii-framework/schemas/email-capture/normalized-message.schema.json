{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://schemas.manolii.com/email-capture/v1/normalized-message.schema.json",
  "title": "normalized-message",
  "required": [
    "schema_version",
    "opaque_id",
    "received_at",
    "envelope",
    "subject",
    "headers",
    "content",
    "attachments"
  ],
  "properties": {
    "schema_version": {
      "pattern": "^1\\.",
      "type": "string"
    },
    "opaque_id": {
      "type": "string"
    },
    "received_at": {
      "type": "string"
    },
    "envelope": {
      "type": "object"
    },
    "subject": {
      "type": "string"
    },
    "headers": {
      "type": "object"
    },
    "content": {
      "type": "object"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
