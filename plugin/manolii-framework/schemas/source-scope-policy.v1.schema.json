{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed owner source-only content boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "scope",
    "allowed_paths",
    "protected_paths"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "scope": {
      "const": "source-only"
    },
    "allowed_paths": {
      "$ref": "#/$defs/paths"
    },
    "protected_paths": {
      "$ref": "#/$defs/paths"
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!/)(?!.*[\\\\*?\\[\\]\\u0000-\\u001f\\u007f\\ud800-\\udfff])(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*/?$"
      }
    }
  }
}
